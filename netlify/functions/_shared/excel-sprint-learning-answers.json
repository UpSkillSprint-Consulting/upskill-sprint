{
  "version": 1,
  "diagnostic": {
    "id": "placement-v1",
    "questions": [
      {
        "id": "q1",
        "skillId": "level-1",
        "correctOption": "c",
        "explanation": "AVERAGE includes numeric zero and ignores a genuinely empty cell: (10+0+20)/3 = 10."
      },
      {
        "id": "q2",
        "skillId": "level-2",
        "correctOption": "a",
        "explanation": "SUMIFS applies both criteria to each row and sums the matching costs. Adding separate conditional sums includes unwanted rows and can double-count."
      },
      {
        "id": "q3",
        "skillId": "level-3",
        "correctOption": "d",
        "explanation": "A first-match or last-match lookup hides duplicate keys. Count matching keys before selecting a value."
      },
      {
        "id": "q4",
        "skillId": "level-4",
        "correctOption": "b",
        "explanation": "CLEAN removes the nonprinting line break, TRIM removes excess ordinary spaces, and UPPER standardizes letters."
      },
      {
        "id": "q5",
        "skillId": "level-5",
        "correctOption": "c",
        "explanation": "For a shift shorter than one day, MOD(end-start,1)*24 returns eight hours. The assumption is essential because MOD discards whole days."
      },
      {
        "id": "q6",
        "skillId": "level-6",
        "correctOption": "a",
        "explanation": "An exception report requested at record level retains every matching row. Deduplicating or averaging would change the report grain."
      },
      {
        "id": "q7",
        "skillId": "level-7",
        "correctOption": "d",
        "explanation": "Pooled yield is 100*(90+50)/(100+1000), rounded to 12.73. An average of the batch percentages weights both batches equally."
      },
      {
        "id": "q8",
        "skillId": "level-8",
        "correctOption": "b",
        "explanation": "LET names intermediate values within one formula, improving readability and allowing reuse. Names do not remove validation requirements."
      },
      {
        "id": "q9",
        "skillId": "level-9",
        "correctOption": "c",
        "explanation": "Use the same complete-pair mask for both arrays. This preserves row alignment, retains numeric zeros and excludes missing measurements."
      },
      {
        "id": "q10",
        "skillId": "level-10",
        "correctOption": "a",
        "explanation": "The missing-input rule has precedence. Evaluate completeness first, then apply the numeric acceptance comparison. These are fictitious training rules."
      }
    ]
  },
