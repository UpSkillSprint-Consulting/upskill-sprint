      ],
      "id": "t3"
    },
    {
      "prompt": "Review reconciliation: return grouped total Cost_CAD from task 3 minus the independent raw Cost_CAD total. Submit numeric zero when reconciled.",
      "output": "Answers!B28",
      "type": "number",
      "formulas": [
        "SUM"
      ],
      "id": "t4"
    }
  ],
