{
  "id": "L9-A1",
  "level": 9,
  "assignment": 1,
  "title": "Group production summaries",
  "formulas": [
    "GROUPBY",
    "SUM"
  ],
  "minutes": 70,
  "scenario": "Kelvani Rolling records 48 fictitious batches for six heats and two shifts. Every batch contributes tonnes and cost; repeated keys aggregate. Report no headers or grand/subtotals, and sort grouping keys ascending.",
  "lesson": {
    "intro": "Formula grouping creates a summary directly from repeated records. Explicit header and total settings prevent a summary from changing shape unexpectedly.",
    "functions": [
      {
        "name": "GROUPBY",
        "purpose": "Aggregate records by row keys.",
        "syntax": "=GROUPBY(row_fields, values, function, [field_headers], [total_depth], [sort_order], [filter_array], [field_relationship])",
        "arguments": "row_fields are grouping columns; values are aligned measures; function aggregates. Headers: 0 none, 1 input hidden, 2 generated, 3 input shown (default auto). Total depth: 0 none, ±1 grand, ±2 subtotals (negative at top; default auto). Sort indices are signed column positions; filter_array is an aligned Boolean mask. Relationship: 0 hierarchy, 1 flat table.",
        "example": "=GROUPBY({\"A\";\"A\";\"B\"},{2;3;7},SUM,0,0,1)",
        "result": "A,5 then B,7",
        "useCase": "Summarize production batches.",
        "mistake": "Specify totals and headers explicitly; aggregates combine duplicate keys."
      },
      {
        "name": "SUM",
        "purpose": "Add numeric inputs.",
        "syntax": "=SUM(number1, [number2], ...)",
        "arguments": "number1 supplies a number or range; optional arguments add inputs.",
        "example": "=SUM(4,7)",
        "result": 11,
        "useCase": "Reconcile a source total.",
        "mistake": "Do not add subtotals to their own detail."
      }
    ],
    "combine": "Review HSTACK and ROUND. Current Microsoft 365 is required; if GROUPBY is unavailable, use a unique-key scaffold with SUMIFS. That alternative is accepted. Use field_relationship 1 for repeated complete key labels in flat reports."
  },
  "tasks": [
