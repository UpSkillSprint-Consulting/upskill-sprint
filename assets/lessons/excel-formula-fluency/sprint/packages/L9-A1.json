      "formulas": [
        "GROUPBY",
        "LAMBDA",
        "SUM"
      ],
      "id": "t2"
    },
    {
      "prompt": "Return Heat_no, Shift, total Produced_t, total Cost_CAD for each combination (12 × 4), heat then shift ascending. Repeat both labels on every row. Round tonnes to two decimals; no headers/totals.",
      "output": "Answers!B14:E25",
      "type": "array",
      "formulas": [
        "GROUPBY",
