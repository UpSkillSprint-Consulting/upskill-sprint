{
  "id": "L4-A2",
  "level": 4,
  "assignment": 2,
  "title": "Read fixed-width business codes",
  "formulas": [
    "LEFT",
    "RIGHT",
    "MID"
  ],
  "minutes": 50,
  "scenario": "Gorvella Inventory has 48 invented item codes in the fixed pattern AA-NNN-Z. Outer ordinary spaces and mixed-case prefixes are present. Each row is an inventory observation, including repeats of the same SKU.",
  "lesson": {
    "intro": "Fixed-width codes can be decomposed by character position once their ordinary outer spaces are removed. Hyphens occupy positions just like letters and digits.",
    "functions": [
      {
        "name": "LEFT",
        "purpose": "Extract the first characters.",
        "syntax": "=LEFT(text, [num_chars])",
        "arguments": "text is the source; num_chars is the count, defaulting to 1.",
        "example": "=LEFT(\"NX-410\",2)",
        "result": "NX",
        "useCase": "Read a fixed-width prefix.",
        "mistake": "Count positions after cleaning the input."
      },
      {
        "name": "RIGHT",
        "purpose": "Extract the last characters.",
        "syntax": "=RIGHT(text, [num_chars])",
        "arguments": "text is the source; num_chars is the count, defaulting to 1.",
        "example": "=RIGHT(\"NX-410\",3)",
        "result": "410",
        "useCase": "Read a fixed-width suffix.",
        "mistake": "The returned digits are text until explicitly converted."
      },
      {
        "name": "MID",
        "purpose": "Extract characters starting at a position.",
        "syntax": "=MID(text, start_num, num_chars)",
        "arguments": "text is the source; start_num is a 1-based position; num_chars is the count.",
        "example": "=MID(\"AB-12-Z\",4,2)",
        "result": "12",
        "useCase": "Read a fixed-width code segment.",
        "mistake": "Position 1 is the first character; separators count too."
      }
    ],
    "combine": "Reuse TRIM/UPPER from the prior level-4 lesson, and IF from Level 1 to assign a category. The extracted number remains text; retain its leading zeros."
  },
  "tasks": [
    {
      "prompt": "For the first six records, return the two-letter uppercase prefix after trimming.",
      "output": "Answers!B2:B7",
      "type": "array",
      "formulas": [
        "LEFT",
        "TRIM",
        "UPPER"
      ],
      "id": "t1"
    },
    {
      "prompt": "For the first six records, return the three-character numeric segment as text, preserving leading zeros.",
      "output": "Answers!B10:B15",
      "type": "array",
      "formulas": [
        "MID",
        "TRIM"
      ],
      "id": "t2"
    },
    {
      "prompt": "For the first six records, return the final one-letter suffix.",
      "output": "Answers!B18:B23",
      "type": "array",
      "formulas": [
        "RIGHT",
        "TRIM"
      ],
      "id": "t3"
    },
    {
      "prompt": "For the first six records, return Priority for suffix A, otherwise Standard.",
      "output": "Answers!B26:B31",
      "type": "array",
      "formulas": [
        "IF",
        "RIGHT",
        "TRIM"
      ],
      "id": "t4"
    }
  ],
  "bonus": {
    "prompt": "Calculate first-row stock value, rounded to cents.",
    "output": "Answers!B34",
    "type": "number",
    "formulas": [
      "ROUND"
    ],
    "id": "bonus"
  },
