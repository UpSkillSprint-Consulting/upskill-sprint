{
  "id": "L6-A3",
  "level": 6,
  "assignment": 3,
  "title": "Create a distinct heat register",
  "formulas": [
    "UNIQUE",
    "SEQUENCE"
  ],
  "minutes": 75,
  "scenario": "Relvani Melt Tracking has 72 invented sample records spanning six heat codes. Heat codes repeat across samples; one blank code represents an incomplete record and must be excluded from the distinct register. Sample counts must still reflect all valid records per heat.",
  "lesson": {
    "intro": "UNIQUE constructs the key register; SEQUENCE supplies a separate display index. Neither function aggregates measurements by itself. Distinguish a missing key from a valid repeated heat.",
    "functions": [
      {
        "name": "UNIQUE",
        "purpose": "Return distinct values or rows.",
        "syntax": "=UNIQUE(array, [by_col], [exactly_once])",
        "arguments": "array supplies values; by_col TRUE compares columns; exactly_once TRUE returns only entries occurring once.",
        "example": "=UNIQUE({\"A\";\"B\";\"A\"})",
        "result": "A then B",
        "useCase": "Create distinct heat/sample pairs.",
        "mistake": "A two-column input distinguishes full row pairs, not each column independently."
      },
      {
        "name": "SEQUENCE",
        "purpose": "Generate a numeric array.",
        "syntax": "=SEQUENCE(rows, [columns], [start], [step])",
        "arguments": "Specify rows; optional columns, starting value and increment determine the grid.",
        "example": "=SEQUENCE(3,1,10,2)",
        "result": "10, 12, 14",
        "useCase": "Number rows or create planned sample indices.",
        "mistake": "Rows and columns must be positive; these numbers do not become observations."
      }
    ],
    "combine": "Reuse SORT for stable ascending heat order, FILTER to exclude blank keys, and COUNTIFS for counts aligned to the spilled register. Do not use exactly_once TRUE when all distinct heats are needed."
  },
  "tasks": [
    {
      "prompt": "Return distinct nonblank Heat_no values sorted ascending.",
      "output": "Answers!B2:B7",
      "type": "array",
      "formulas": [
        "UNIQUE",
        "SORT",
        "FILTER"
      ],
      "id": "t1"
    },
    {
      "prompt": "Return display numbers 1 through 6 as a six-row column.",
      "output": "Answers!B10:B15",
      "type": "array",
      "formulas": [
        "SEQUENCE"
      ],
      "id": "t2"
    },
    {
      "prompt": "Return the sample-record counts for the six sorted nonblank heats in the same order as the register.",
      "output": "Answers!B18:B23",
      "type": "array",
      "formulas": [
        "COUNTIFS",
        "UNIQUE",
        "FILTER",
        "SORT"
      ],
      "id": "t3"
    },
    {
      "prompt": "Return two columns: sorted nonblank Heat_no and its record count.",
      "output": "Answers!B26:C31",
      "type": "array",
      "formulas": [
        "HSTACK",
        "UNIQUE",
        "COUNTIFS",
        "FILTER",
        "SORT"
      ],
      "id": "t4"
    }
  ],
  "bonus": {
    "prompt": "Count records with a blank Heat_no.",
    "output": "Answers!B34",
    "type": "number",
    "formulas": [
      "COUNTIFS"
    ],
    "id": "bonus"
  },
