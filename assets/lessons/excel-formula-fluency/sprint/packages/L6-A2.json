{
  "id": "L6-A2",
  "level": 6,
  "assignment": 2,
  "title": "Sort a business priority queue",
  "formulas": [
    "SORTBY",
    "CHOOSEROWS"
  ],
  "minutes": 70,
  "scenario": "Qervella Orders has 68 invented orders with Urgency_score and Order_value_CAD. Scores and values can repeat; Order_code ascending is the final tie-break. Blank Customer_code fields are intentional and do not remove an order from the queue.",
  "lesson": {
    "intro": "A reproducible queue needs explicit tie-breaks. SORTBY can order by urgency descending, value descending and code ascending while returning the original row columns.",
    "functions": [
      {
        "name": "SORTBY",
        "purpose": "Sort by one or more aligned key arrays.",
        "syntax": "=SORTBY(array, by_array1, [sort_order1], [by_array2], [sort_order2], ...)",
        "arguments": "array is returned; each by_array and order pair supplies a primary or subsequent key.",
        "example": "=SORTBY({\"A\";\"B\"},{3;1},1)",
        "result": "B then A",
        "useCase": "Prioritize orders with a deterministic tie-break.",
        "mistake": "Key arrays must align with the returned rows."
      },
      {
        "name": "CHOOSEROWS",
        "purpose": "Select and reorder array rows.",
        "syntax": "=CHOOSEROWS(array, row_num1, [row_num2], ...)",
        "arguments": "Provide the array and 1-based row indices; negative indices count back from its last row.",
        "example": "=CHOOSEROWS({10;20;30},1,-1)",
        "result": "10 then 30",
        "useCase": "Inspect the first and last records.",
        "mistake": "Indices apply to the current array, after any filtering or sorting."
      }
    ],
    "combine": "Reuse ROUND for values and IF for a review flag. CHOOSEROWS selects positions after sorting, not source worksheet row numbers. Keep related fields together so row identity survives sorting."
  },
