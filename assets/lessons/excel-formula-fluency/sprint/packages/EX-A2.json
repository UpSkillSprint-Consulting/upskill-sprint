{
  "id": "EX-A2",
  "track": "expert",
  "assignment": 2,
  "title": "Reshape duplicate Charpy measurements",
  "formulas": [
    "AVERAGEIFS",
    "COUNTIFS"
  ],
  "minutes": 75,
  "scenario": "Chelloran Test Lab has 80 fictitious observations: twenty sample/heat pairs, two orientations and two replicate slots per orientation. Sample_no alone is not unique. Group by BOTH Sample_no and Heat_no. Normalize Orientation using TRIM/UPPER. Average numeric replicate energies (J), include measured zero, ignore blanks, round to two decimals and return Missing when no numeric observation exists. Do not select the first duplicate measurement.",
  "lesson": {
    "intro": "A replicated test needs an explicit aggregation rule. Use separate sample and heat criteria, and confirm observations exist before averaging. Clean orientation labels once and reuse them.",
    "functions": [
      {
        "name": "AVERAGEIFS",
        "purpose": "Average numeric observations meeting all criteria.",
        "syntax": "=AVERAGEIFS(average_range, criteria_range1, criteria1, [criteria_range2, criteria2], …)",
        "arguments": "All ranges must align. Example: A2:A4 contains A, B, A; B2:B4 contains 10, 20, 30.",
        "example": "=AVERAGEIFS(B2:B4,A2:A4,\"A\")",
        "result": 20,
        "useCase": "Build and audit the capstone report.",
        "mistake": "No matching numeric observations produces an error. A measured zero counts; missing data must remain missing."
      },
      {
        "name": "COUNTIFS",
        "purpose": "Count observations meeting all criteria.",
        "syntax": "=COUNTIFS(criteria_range1, criteria1, [criteria_range2, criteria2], …)",
        "arguments": "Pair aligned ranges and criteria. Example: A2:A4 contains A, A, B; B2:B4 contains 1, 2, 3.",
        "example": "=COUNTIFS(A2:A4,\"A\",B2:B4,\">1\")",
        "result": 1,
        "useCase": "Build and audit the capstone report.",
        "mistake": "Counting a key alone does not prove that its measurement exists."
      }
    ],
    "combine": "UNIQUE on a two-column array preserves joint identity. Reuse COUNTIFS and AVERAGEIFS across orientations, then HSTACK keys and energies. Keep the sorted order fixed."
  },
  "tasks": [
    {
      "id": "t1",
      "prompt": "Normalize all 80 Orientation labels using ordinary-space trimming and uppercase. Preserve Data order.",
      "output": "Answers!B2:B81",
      "type": "array"
    },
    {
      "id": "t2",
      "prompt": "Return the twenty distinct Sample_no and Heat_no pairs, sorted Sample_no ascending, then Heat_no ascending. Preserve the three-character sample identifiers.",
      "output": "Answers!B85:C104",
      "type": "array"
    },
    {
      "id": "t3",
      "prompt": "For the sorted pairs, return two columns: mean LPA energy and mean TWA energy (J). Apply the numeric-replicate and Missing rules. Keep the key order from Task 2.",
      "output": "Answers!B108:C127",
      "type": "array"
    },
    {
      "id": "t4",
      "prompt": "Return the final twenty-row report: Sample_no, Heat_no, mean LPA_J, mean TWA_J. Preserve the Task 2 sort order and Missing labels.",
      "output": "Answers!B131:E150",
      "type": "array"
    }
  ],
  "bonus": {
    "id": "bonus",
    "prompt": "Count sample/heat pairs missing at least one orientation mean. Count each pair once.",
    "output": "Answers!B154",
    "type": "number"
  },
