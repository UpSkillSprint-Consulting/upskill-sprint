{
  "id": "L4-A5",
  "level": 4,
  "assignment": 5,
  "title": "Build readable measurement messages",
  "formulas": [
    "SUBSTITUTE",
    "TEXT",
    "PROPER"
  ],
  "minutes": 65,
  "scenario": "Jelvani Quality Services has 60 invented readings for a training report. Raw sample IDs use underscores and inconsistent case; numeric measurements must remain numeric in Data. Messages need stable decimal places and standardized text.",
  "lesson": {
    "intro": "Report text is a presentation layer. Normalize a separator deliberately, and format numeric values only when assembling a message. Preserve raw readings for analysis.",
    "functions": [
      {
        "name": "SUBSTITUTE",
        "purpose": "Replace specified text.",
        "syntax": "=SUBSTITUTE(text, old_text, new_text, [instance_num])",
        "arguments": "Input, old text and replacement are required. Optional instance_num limits replacement to one occurrence.",
        "example": "=SUBSTITUTE(\"A_B_C\",\"_\",\"-\")",
        "result": "A-B-C",
        "useCase": "Normalize separators.",
        "mistake": "Replacement is case-sensitive; it is not a wildcard search."
      },
      {
        "name": "TEXT",
        "purpose": "Format a value as text.",
        "syntax": "=TEXT(value, format_text)",
        "arguments": "value is numeric/date data; format_text is a quoted Excel number-format code.",
        "example": "=TEXT(12.5,\"0.00\")",
        "result": "12.50",
        "useCase": "Include formatted measurements in a sentence.",
        "mistake": "The result is text and should not replace numeric calculation inputs."
      },
      {
        "name": "PROPER",
        "purpose": "Capitalize each word.",
        "syntax": "=PROPER(text)",
        "arguments": "text is the string or reference.",
        "example": "=PROPER(\"nora vale\")",
        "result": "Nora Vale",
        "useCase": "Present fictitious customer names.",
        "mistake": "Acronyms and mixed-case brands may need deliberate exceptions."
      }
    ],
    "combine": "Reuse ROUND for numeric results and IF for a training threshold. TEXT(\"0.00\") controls displayed decimals, while ROUND changes the numeric value. PROPER is suitable for these invented plain names; it is not a universal name-correction rule."
  },
  "tasks": [
    {
      "prompt": "For the first six records, replace all underscores with hyphens, trim ordinary spaces and uppercase the sample ID.",
      "output": "Answers!B2:B7",
      "type": "array",
      "formulas": [
        "SUBSTITUTE",
        "TRIM",
        "UPPER"
      ],
      "id": "t1"
    },
    {
      "prompt": "For the first six records, return Reading_mm as text with exactly three decimals.",
      "output": "Answers!B10:B15",
      "type": "array",
      "formulas": [
        "TEXT"
      ],
      "id": "t2"
    },
    {
      "prompt": "For the first six technicians, return title-case names.",
      "output": "Answers!B18:B23",
      "type": "array",
      "formulas": [
        "PROPER"
      ],
      "id": "t3"
    },
    {
      "prompt": "For the first six records, create messages SAMPLE: 0.00 mm | STATUS, where SAMPLE is the normalized ID, STATUS is Review if the unrounded reading exceeds 13.00, otherwise Within. Use exactly the shown spaces and two displayed decimals.",
      "output": "Answers!B26:B31",
      "type": "array",
      "formulas": [
        "SUBSTITUTE",
        "TEXT",
        "IF",
        "TRIM",
        "UPPER"
      ],
      "id": "t4"
    }
  ],
  "bonus": {
    "prompt": "Return the first reading rounded numerically to two decimals.",
    "output": "Answers!B34",
    "type": "number",
    "formulas": [
      "ROUND"
    ],
    "id": "bonus"
  },
