{
  "id": "L1-A3",
  "level": 1,
  "assignment": 3,
  "title": "Mechanical test extremes",
  "formulas": [
    "MIN",
    "MAX"
  ],
  "minutes": 35,
  "scenario": "Orvanta Tube Lab is reviewing 28 fictitious tensile specimens from the Talren rolling line. Yield strength and tensile strength are measured in MPa; elongation is a percentage. The report needs observed extremes and spread, without declaring compliance with any real specification.",
  "lesson": {
    "intro": "An observed extreme is a descriptive result. It is not automatically a specification limit or a control limit. Select the relevant measured column and keep its units.",
    "functions": [
      {
        "name": "MIN",
        "purpose": "Return the smallest numeric value.",
        "syntax": "=MIN(number1, [number2], ...)",
        "arguments": "number1 is a value or range; optional arguments include additional values or ranges.",
        "example": "=MIN(432,457,441)",
        "result": 432,
        "useCase": "Find the lowest measured strength or price.",
        "mistake": "Text and blanks in references are ignored; a real zero participates."
      },
      {
        "name": "MAX",
        "purpose": "Return the largest numeric value.",
        "syntax": "=MAX(number1, [number2], ...)",
        "arguments": "number1 supplies the first numeric input or range; later inputs are optional.",
        "example": "=MAX(532,548,539)",
        "result": 548,
        "useCase": "Find the highest observed test value.",
        "mistake": "Maximum does not identify which specimen produced it; that needs a later lookup technique."
      }
    ],
    "combine": "Observed range is MAX minus MIN of the same measured column. Reuse AVERAGE to express that range relative to the mean. A cross-column strength ratio is dimensionless because both inputs use MPa; it is a descriptive comparison only."
  },
  "tasks": [
    {
      "id": "t1",
      "prompt": "Find the lowest Yield_MPa across all specimens.",
      "output": "Answers!B2",
      "type": "number",
      "formulas": [
        "MIN"
      ]
    },
    {
      "id": "t2",
      "prompt": "Find the highest Tensile_MPa across all specimens.",
      "output": "Answers!B3",
      "type": "number",
      "formulas": [
        "MAX"
      ]
    },
    {
      "id": "t3",
      "prompt": "Calculate the observed elongation range: largest minus smallest Elongation_pct, in percentage points.",
      "output": "Answers!B4",
      "type": "number",
      "formulas": [
        "MAX",
        "MIN"
      ]
    },
    {
      "id": "t4",
      "prompt": "Calculate maximum tensile strength divided by minimum yield strength. Submit the unrounded dimensionless ratio.",
      "output": "Answers!B5",
      "type": "number",
      "formulas": [
        "MAX",
        "MIN"
      ]
    }
  ],
  "bonus": {
    "id": "bonus",
    "prompt": "Calculate 100 times the yield-strength range divided by mean yield strength. Submit the unrounded percentage number.",
    "output": "Answers!B7",
    "type": "number",
    "formulas": [
      "MAX",
      "MIN",
      "AVERAGE"
    ]
  },
