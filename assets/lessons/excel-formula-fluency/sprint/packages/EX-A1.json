{
  "id": "EX-A1",
  "track": "expert",
  "assignment": 1,
  "title": "Reconcile a manufacturing release queue",
  "formulas": [
    "LET",
    "SUMPRODUCT"
  ],
  "minutes": 75,
  "scenario": "Ravellen Tube Works has 60 fictitious pipe inspections. Normalize Grade_code, match a unique Specs key and apply the invented minimum yield strength. Blank strength or an unknown grade means Review. Equality meets the training rule. Rework cost is Length_m × Unit_cost_CAD rounded per pipe to two decimals. These limits are training assumptions, not a published standard or production acceptance decision.",
  "lesson": {
    "intro": "Reuse a lookup and its missing-data guard with LET. Use aligned arrays to reconcile costs. Work through cleaning, status, queue and summary in separate answer areas.",
    "functions": [
      {
        "name": "LET",
        "purpose": "Name intermediate calculations inside a formula.",
        "syntax": "=LET(name1, name_value1, [name2, name_value2], …, calculation)",
        "arguments": "Supply name/value pairs, then a final calculation. Names must be valid Excel names.",
        "example": "=LET(units,3,rate,12,units*rate)",
        "result": 36,
        "useCase": "Build and audit the capstone report.",
        "mistake": "Names are local to the formula. A name cannot conflict with a cell or range reference."
      },
      {
        "name": "SUMPRODUCT",
        "purpose": "Sum products of aligned numeric arrays.",
        "syntax": "=SUMPRODUCT(array1, [array2], …)",
        "arguments": "Supply equally sized arrays. Convert Boolean masks to numbers when using separate arguments.",
        "example": "=SUMPRODUCT({2;3},{10;4})",
        "result": 32,
        "useCase": "Build and audit the capstone report.",
        "mistake": "Unequal shapes error. Text is treated as zero in ordinary array arguments; validate required inputs."
      }
    ],
    "combine": "Combine TRIM, UPPER, XLOOKUP and IF before FILTER/SORTBY. Compare the summary with an independent source calculation. Equivalent formulas and explicit helper cells are accepted."
  },
  "tasks": [
    {
      "id": "t1",
      "prompt": "Normalize every Grade_code with ordinary-space trimming and uppercase. Keep Data order.",
      "output": "Answers!B2:B61",
      "type": "array"
    },
    {
      "id": "t2",
      "prompt": "For every pipe, return Released, Rework or Review under the scenario rules. Keep Data order. Do not treat a blank strength as zero.",
      "output": "Answers!B65:B124",
      "type": "array"
    },
    {
      "id": "t3",
      "prompt": "Return only Rework pipes in two columns: Pipe_no and rounded rework cost (CAD). Sort cost descending, then Pipe_no ascending. Paste all 27 rows, without headers.",
      "output": "Answers!B128:C154",
      "type": "array"
    },
    {
      "id": "t4",
      "prompt": "Return one row: Released count, Rework count, Review count, total rounded rework cost (CAD). Use all 60 records and round the final cost to two decimals.",
      "output": "Answers!B191:E191",
      "type": "array"
    }
  ],
  "bonus": {
    "id": "bonus",
    "prompt": "Return the average measured Yield_MPa for Released pipes, rounded to two decimals.",
    "output": "Answers!B195",
    "type": "number"
  },
