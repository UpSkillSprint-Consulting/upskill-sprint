{
  "id": "L6-A4",
  "level": 6,
  "assignment": 4,
  "title": "Combine two stock extracts",
  "formulas": [
    "VSTACK",
    "HSTACK",
    "TAKE",
    "DROP"
  ],
  "minutes": 80,
  "scenario": "Servella Stock Control has 40 invented warehouse-A observations and 40 separate warehouse-B observations on Secondary. Schemas and units are aligned; repeated SKU values across warehouses remain separate records. One blank SKU in each extract must not be included in the ranked report.",
  "lesson": {
    "intro": "Stacking requires schema and identity alignment. VSTACK appends compatible observations; HSTACK combines columns only when they refer to the same row keys. TAKE and DROP then create bounded views.",
    "functions": [
      {
        "name": "VSTACK",
        "purpose": "Append arrays vertically.",
        "syntax": "=VSTACK(array1, [array2], ...)",
        "arguments": "Supply arrays to append in order, preserving their column positions.",
        "example": "=VSTACK({1,2},{3,4})",
        "result": "1,2 then 3,4",
        "useCase": "Combine two aligned production extracts.",
        "mistake": "Different widths create padded #N/A cells; align the schema first."
      },
      {
        "name": "HSTACK",
        "purpose": "Append arrays horizontally.",
        "syntax": "=HSTACK(array1, [array2], ...)",
        "arguments": "Supply arrays to append side by side, with matching row counts.",
        "example": "=HSTACK({1;2},{3;4})",
        "result": "1,3 then 2,4",
        "useCase": "Put orientation results beside sample keys.",
        "mistake": "Different heights cause #N/A padding; row identity must also agree."
      },
      {
        "name": "TAKE",
        "purpose": "Keep leading or trailing rows/columns.",
        "syntax": "=TAKE(array, rows, [columns])",
        "arguments": "Signed rows selects first/last rows; optional signed columns selects first/last columns.",
        "example": "=TAKE({10;20;30},2)",
        "result": "10 then 20",
        "useCase": "Show a bounded priority list.",
        "mistake": "Zero rows errors; ensure enough rows for the requested result."
      },
      {
        "name": "DROP",
        "purpose": "Remove leading or trailing rows/columns.",
        "syntax": "=DROP(array, rows, [columns])",
        "arguments": "Signed rows removes leading/trailing rows; optional columns does the same for columns.",
        "example": "=DROP({10;20;30},1)",
        "result": "20 then 30",
        "useCase": "Exclude a known first record in a combined extract.",
        "mistake": "Dropping the entire array leaves an empty-array error."
      }
    ],
    "combine": "Reuse FILTER to exclude blank SKUs, SORTBY for stock descending with SKU ascending as the tie-break, and ROUND for value calculations. The raw combined extract keeps duplicates; aggregation would be a separate task."
  },
  "tasks": [
