      ],
      "id": "t2"
    },
    {
      "prompt": "Return the first five records of the full combined raw extract (Data followed by Secondary), including all four columns.",
      "output": "Answers!B17:E21",
      "type": "array",
      "formulas": [
        "TAKE",
        "VSTACK"
      ],
      "id": "t3"
    },
    {
      "prompt": "Return the first three combined raw records after removing the first two records, as three rows and four columns.",
