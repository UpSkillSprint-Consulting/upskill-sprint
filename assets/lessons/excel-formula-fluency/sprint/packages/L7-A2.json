{
  "id": "L7-A2",
  "level": 7,
  "assignment": 2,
  "title": "Build a multi-criteria order lookup",
  "formulas": [
    "XMATCH",
    "XLOOKUP"
  ],
  "minutes": 55,
  "scenario": "Belvori Sales has 36 fictitious order lines. Customer and Product jointly identify an order request only when exactly one line matches; duplicate combinations are ambiguous. Requests includes unique, duplicate and absent combinations.",
  "lesson": {
    "intro": "Combining exact conditions produces a lookup mask. A value of one means all requested conditions match, but several ones still mean an ambiguous request.",
    "functions": [
      {
        "name": "XMATCH",
        "purpose": "Find a relative position.",
        "syntax": "=XMATCH(lookup_value, lookup_array, [match_mode], [search_mode])",
        "arguments": "Supply key and one-dimensional range; match mode 0 exact, -1 next smaller, 1 next larger, 2 wildcard; search 1 forward, -1 reverse, 2 ascending binary, -2 descending binary.",
        "example": "=XMATCH(\"B\",{\"A\",\"B\"},0,1)",
        "result": 2,
        "useCase": "Match both dimensions of a specification.",
        "mistake": "Binary modes require sorted keys. A first match does not prove uniqueness."
      },
      {
        "name": "XLOOKUP",
        "purpose": "Return a value for a key.",
        "syntax": "=XLOOKUP(lookup_value, lookup_array, return_array, [if_not_found], [match_mode], [search_mode])",
        "arguments": "Supply key, aligned lookup and return arrays, optional missing result; match mode 0 exact, -1 next smaller, 1 next larger, 2 wildcard; search 1 forward, -1 reverse, 2/-2 sorted binary.",
        "example": "=XLOOKUP(\"B\",{\"A\",\"B\"},{12,18},\"Missing\",0,1)",
        "result": 18,
        "useCase": "Retrieve an unambiguous order.",
        "mistake": "Count duplicate matches before selecting a value."
      }
    ],
    "combine": "Review COUNTIFS before a lookup. Use XMATCH(1,mask,0) for a position or XLOOKUP(1,mask,return_range) for a value. Do not silently pick the first duplicate. Any valid Excel formula is accepted."
  },
  "tasks": [
    {
      "prompt": "For all six Requests rows, return matching-line counts as a 6 × 1 column in request order.",
      "output": "Answers!B2:B7",
      "type": "array",
      "formulas": [
        "COUNTIFS"
      ],
      "id": "t1"
    },
    {
      "prompt": "For all six requests, return Order_no only for exactly one match; return Review key for zero or multiple matches.",
      "output": "Answers!B10:B15",
      "type": "array",
      "formulas": [
        "IF",
        "XLOOKUP",
        "COUNTIFS"
      ],
      "id": "t2"
    },
    {
      "prompt": "Return the first request’s 1-based matching position within Data rows, using both conditions.",
      "output": "Answers!B18",
      "type": "number",
      "formulas": [
        "XMATCH"
      ],
      "id": "t3"
    },
    {
      "prompt": "Return all complete Data rows matching the second request, in source order. Keep both duplicate lines (2 × 5).",
      "output": "Answers!B21:F22",
      "type": "array",
      "formulas": [
        "FILTER"
      ],
      "id": "t4"
    }
  ],
  "bonus": {
    "prompt": "Review SUMIFS: total Units across every line matching the second request.",
    "output": "Answers!B25",
    "type": "number",
    "formulas": [
      "SUMIFS"
    ],
    "id": "bonus"
  },
