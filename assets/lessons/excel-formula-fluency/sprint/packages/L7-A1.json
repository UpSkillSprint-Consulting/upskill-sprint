{
  "id": "L7-A1",
  "level": 7,
  "assignment": 1,
  "title": "Calculate weighted production rates",
  "formulas": [
    "SUMPRODUCT",
    "SUM"
  ],
  "minutes": 50,
  "scenario": "Avenro Rolling records 40 fictitious production batches. Yield is good units divided by inspected units, expressed as a percentage number. Batches are independent records; repeated shift names aggregate and all input quantities are numeric.",
  "lesson": {
    "intro": "A weighted result gives each batch its appropriate denominator weight. Multiplying aligned arrays is useful for quantity-times-rate totals and Boolean selection.",
    "functions": [
      {
        "name": "SUMPRODUCT",
        "purpose": "Sum aligned products.",
        "syntax": "=SUMPRODUCT(array1, [array2], ...)",
        "arguments": "array1 is the first bounded numeric array; optional arrays have identical dimensions and multiply elementwise.",
        "example": "=SUMPRODUCT({2,3},{4,5})",
        "result": 23,
        "useCase": "Calculate weighted yield or condition counts.",
        "mistake": "Align rows. Coerce Boolean conditions with --; distinguish blanks from measured zero."
      },
      {
        "name": "SUM",
        "purpose": "Add numeric inputs.",
        "syntax": "=SUM(number1, [number2], ...)",
        "arguments": "number1 supplies a number or range; optional arguments add inputs.",
        "example": "=SUM(4,7)",
        "result": 11,
        "useCase": "Reconcile a source total.",
        "mistake": "Do not add subtotals to their own detail."
      }
    ],
    "combine": "Review SUM and ROUND. Multiply a Boolean mask by numeric quantities to select rows. Compare a ratio of totals with an unweighted average: they answer different questions. Any valid Excel formula is accepted; submit unrounded results unless rounding is requested."
  },
  "tasks": [
    {
      "prompt": "Calculate pooled good yield: 100 × total Good_units / total Inspected_units across all 40 batches.",
      "output": "Answers!B2",
      "type": "number",
      "formulas": [
        "SUM"
      ],
      "id": "t1"
    },
    {
      "prompt": "Calculate total operating cost as the sum of each batch’s Hours_h × Rate_CAD_per_h. Submit unrounded CAD.",
      "output": "Answers!B5",
      "type": "number",
      "formulas": [
        "SUMPRODUCT"
      ],
      "id": "t2"
    },
    {
      "prompt": "Calculate total Good_units for Day batches only.",
      "output": "Answers!B8",
      "type": "number",
      "formulas": [
        "SUMPRODUCT"
      ],
      "id": "t3"
    },
    {
      "prompt": "Calculate Day operating cost per Day good unit: selected hours × rates / selected good units. Submit unrounded CAD/unit.",
      "output": "Answers!B11",
      "type": "number",
      "formulas": [
        "SUMPRODUCT"
      ],
      "id": "t4"
    }
  ],
  "bonus": {
