{
  "id": "L5-A2",
  "level": 5,
  "assignment": 2,
  "title": "Plan calendar-month replenishment",
  "formulas": [
    "EDATE",
    "EOMONTH"
  ],
  "minutes": 60,
  "scenario": "Lervella Stores has 48 invented replenishment records. Year, month and day are explicit components; first-row January 31 exercises a shorter-month boundary. Renewal_months are whole calendar months, not fixed 30-day intervals.",
  "lesson": {
    "intro": "Calendar-month offsets preserve the intended day where possible, clamping it when the destination month is shorter. Month-end reporting uses a separate function.",
    "functions": [
      {
        "name": "EDATE",
        "purpose": "Shift a date by whole months.",
        "syntax": "=EDATE(start_date, months)",
        "arguments": "Supply a start date and signed month offset.",
        "example": "=TEXT(EDATE(DATE(2026,1,31),1),\"yyyy-mm-dd\")",
        "result": "2026-02-28",
        "useCase": "Plan replenishment or contract renewal.",
        "mistake": "Shorter months clamp to their last day; 30 days is not one calendar month."
      },
      {
        "name": "EOMONTH",
        "purpose": "Find a month-end date.",
        "syntax": "=EOMONTH(start_date, months)",
        "arguments": "start_date is a date; months is the forward/backward month offset.",
        "example": "=TEXT(EOMONTH(DATE(2026,2,3),0),\"yyyy-mm-dd\")",
        "result": "2026-02-28",
        "useCase": "Set a reporting cutoff.",
        "mistake": "It returns a date serial; apply a date format or TEXT for submission."
      }
    ],
    "combine": "Reuse DATE to build the source date and TEXT for ISO submission. Reuse ROUND for order value; keeping date and financial calculations separate makes their units clear."
  },
  "tasks": [
