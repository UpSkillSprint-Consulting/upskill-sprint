{
  "id": "L8-A1",
  "level": 8,
  "assignment": 1,
  "title": "Name intermediate yield calculations",
  "formulas": [
    "LET",
    "ISNUMBER"
  ],
  "minutes": 60,
  "scenario": "Felvori Meltworks records 44 fictitious heats with charged and tapped tonnes. Blank tapped mass is unmeasured; complete heats have a positive charged mass. Pooled yield includes only complete heats, and melt loss costs 620 CAD per lost tonne.",
  "lesson": {
    "intro": "Names inside LET make a repeated expression easier to audit. A completeness mask should govern both sides of a pooled ratio so incomplete records cannot distort it.",
    "functions": [
      {
        "name": "LET",
        "purpose": "Name intermediate expressions.",
        "syntax": "=LET(name1, name_value1, [name2, name_value2], ..., calculation)",
        "arguments": "Provide a valid name/value pair, optional further pairs, and the final expression using those names; up to 126 pairs.",
        "example": "=LET(amount,12,fee,3,amount-fee)",
        "result": 9,
        "useCase": "Calculate a guarded yield once.",
        "mistake": "Names cannot collide with cell references; the last argument returns the result."
      },
      {
        "name": "ISNUMBER",
        "purpose": "Test the stored value type.",
        "syntax": "=ISNUMBER(value)",
        "arguments": "value is the cell or expression to test.",
        "example": "=ISNUMBER(0)",
        "result": true,
        "useCase": "Keep measured zero and exclude blank results.",
        "mistake": "A numeric-looking text string is not a number."
      }
    ],
    "combine": "Review FILTER, SORTBY and ROUND. Name the population and its quantities once, then return the result. Missing results remain Missing, not zero loss. Any valid formula is accepted. Pooled yield is a percentage number."
  },
  "tasks": [
    {
      "prompt": "For the first eight heats, return Charged_t − Tapped_t rounded to two decimals, or Missing for blank tapped mass.",
      "output": "Answers!B2:B9",
      "type": "array",
      "formulas": [
        "LET",
        "ISNUMBER",
        "IF",
        "ROUND"
      ],
      "id": "t1"
    },
    {
      "prompt": "Return pooled yield for complete heats only: 100 × selected tapped tonnes / selected charged tonnes. Submit unrounded.",
      "output": "Answers!B12",
      "type": "number",
      "formulas": [
        "LET",
        "FILTER",
        "SUM"
      ],
      "id": "t2"
    },
    {
      "prompt": "Return Heat_no, loss_t and yield_pct for all complete heats. Round both metrics to two decimals; sort by rounded yield descending, then Heat_no ascending. No headers.",
      "output": "Answers!B15:D53",
      "type": "array",
      "formulas": [
        "LET",
        "FILTER",
        "HSTACK",
        "SORTBY",
        "ROUND"
      ],
      "id": "t3"
    },
    {
      "prompt": "Calculate complete-heat melt-loss cost: 620 × total charged-minus-tapped tonnes. Round the final CAD total to cents.",
      "output": "Answers!B56",
      "type": "number",
      "formulas": [
        "LET",
        "FILTER",
        "SUM",
        "ROUND"
      ],
      "id": "t4"
    }
  ],
