{
  "id": "L9-A3",
  "level": 9,
  "assignment": 3,
  "title": "Measure variation and inclusive percentiles",
  "formulas": [
    "STDEV.S",
    "PERCENTILE.INC"
  ],
  "minutes": 80,
  "scenario": "Mervali Inspection has 48 fictitious wall-thickness observations in mm, including unmeasured blank cells. Numeric observations alone form the descriptive sample. Training specification limits are 9.7–10.3 mm inclusive; these are not statistical control limits.",
  "lesson": {
    "intro": "A sample standard deviation describes spread using n−1. Inclusive percentiles interpolate between sorted numeric observations. Both describe this sample without proving process stability.",
    "functions": [
      {
        "name": "STDEV.S",
        "purpose": "Estimate sample standard deviation.",
        "syntax": "=STDEV.S(number1, [number2], ...)",
        "arguments": "number1 is a numeric sample or range; optional arguments add observations; the denominator is n−1.",
        "example": "=STDEV.S(8,10,12)",
        "result": 2,
        "useCase": "Describe observed variation.",
        "mistake": "At least two numeric values are needed. Sample spread does not prove stability."
      },
      {
        "name": "PERCENTILE.INC",
        "purpose": "Find an inclusive sample percentile.",
        "syntax": "=PERCENTILE.INC(array, k)",
        "arguments": "array supplies numeric observations; k is a proportion from 0 through 1; intermediate positions use linear interpolation.",
        "example": "=PERCENTILE.INC({4;8;12},0.75)",
        "result": 10,
        "useCase": "Summarize a high-end thickness value.",
        "mistake": "Use 0.9 for the 90th percentile, not 90."
      }
    ],
    "combine": "Review COUNT, AVERAGE, ISNUMBER and ROUND. Ignore blanks consistently. Specification failures use strict less-than/greater-than comparisons because both limits are inclusive. Any valid formula is accepted; do not round the standard deviation."
  },
  "tasks": [
    {
      "prompt": "Return sample standard deviation of all numeric Thickness_mm observations. Submit unrounded mm.",
      "output": "Answers!B2",
      "type": "number",
      "formulas": [
        "STDEV.S"
      ],
      "id": "t1"
    },
    {
      "prompt": "Return the inclusive 50th percentile of numeric thickness, rounded to three decimals.",
      "output": "Answers!B5",
      "type": "number",
      "formulas": [
        "PERCENTILE.INC",
        "ROUND"
      ],
      "id": "t2"
    },
    {
      "prompt": "Return the inclusive 90th percentile of numeric thickness, rounded to three decimals.",
      "output": "Answers!B8",
      "type": "number",
      "formulas": [
        "PERCENTILE.INC",
        "ROUND"
      ],
      "id": "t3"
    },
    {
      "prompt": "Count numeric observations outside the inclusive 9.7–10.3 mm training specification. Exclude unmeasured cells.",
      "output": "Answers!B11",
      "type": "number",
      "formulas": [
        "SUMPRODUCT",
        "ISNUMBER"
      ],
      "id": "t4"
    }
  ],
