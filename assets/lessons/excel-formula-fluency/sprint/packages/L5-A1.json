{
  "id": "L5-A1",
  "level": 5,
  "assignment": 1,
  "title": "Build a test reporting calendar",
  "formulas": [
    "DATE",
    "EOMONTH"
  ],
  "minutes": 55,
  "scenario": "Kelvani Materials Lab has 44 invented test-date components. Dates are valid numeric year/month/day values, avoiding locale-dependent parsing. Reporting months use calendar month ends; repeated test dates remain separate samples.",
  "lesson": {
    "intro": "Construct dates from explicit components rather than trusting a computer’s regional date interpretation. Date functions return serial values; submit ISO text where requested.",
    "functions": [
      {
        "name": "DATE",
        "purpose": "Construct an Excel date from components.",
        "syntax": "=DATE(year, month, day)",
        "arguments": "Supply a four-digit year, month number and day number.",
        "example": "=TEXT(DATE(2026,2,3),\"yyyy-mm-dd\")",
        "result": "2026-02-03",
        "useCase": "Build locale-independent dates.",
        "mistake": "Excel normalizes overflow days/months; validate unexpected components."
      },
      {
        "name": "EOMONTH",
        "purpose": "Find a month-end date.",
        "syntax": "=EOMONTH(start_date, months)",
        "arguments": "start_date is a date; months is the forward/backward month offset.",
        "example": "=TEXT(EOMONTH(DATE(2026,2,3),0),\"yyyy-mm-dd\")",
        "result": "2026-02-28",
        "useCase": "Set a reporting cutoff.",
        "mistake": "It returns a date serial; apply a date format or TEXT for submission."
      }
    ],
    "combine": "Reuse TEXT from Level 4 to return yyyy-mm-dd and COUNTIFS from Level 2 for component counts. The reporting cutoff is month end, including leap-year rules handled by Excel."
  },
  "tasks": [
    {
      "prompt": "For the first six records, construct dates and return ISO text yyyy-mm-dd.",
      "output": "Answers!B2:B7",
      "type": "array",
      "formulas": [
        "DATE",
        "TEXT"
      ],
      "id": "t1"
    },
    {
      "prompt": "For the first six records, return the calendar month-end cutoff as ISO text.",
      "output": "Answers!B10:B15",
      "type": "array",
      "formulas": [
        "EOMONTH",
        "DATE",
        "TEXT"
      ],
      "id": "t2"
    },
    {
      "prompt": "For the first record, count calendar days from its test date to month end, excluding the starting date.",
      "output": "Answers!B18",
      "type": "number",
