{
  "id": "L10-A5",
  "level": 10,
  "assignment": 5,
  "title": "Complete the integrated Charpy capstone",
  "formulas": [
    "LET",
    "MAP"
  ],
  "minutes": 100,
  "scenario": "Tervali Pipe Lab has 48 fictitious Charpy replicates for twelve sample/heat pairs. Average numeric duplicate energies by both keys and normalized orientation; round means to two decimals. Training LPA/TWA minima are 27/20 J inclusive; missing means require Review, either low mean means Hold, otherwise Pass.",
  "lesson": {
    "intro": "The capstone combines a key scaffold, guarded replicate means, a decision rule and a reconciled cost summary. Each intermediate result has an explicit shape and business meaning.",
    "functions": [
      {
        "name": "LET",
        "purpose": "Name intermediate expressions.",
        "syntax": "=LET(name1, name_value1, [name2, name_value2], ..., calculation)",
        "arguments": "Provide a valid name/value pair, optional further pairs, and the final expression using those names; up to 126 pairs.",
        "example": "=LET(amount,12,fee,3,amount-fee)",
        "result": 9,
        "useCase": "Calculate a guarded yield once.",
        "mistake": "Names cannot collide with cell references; the last argument returns the result."
      },
      {
        "name": "MAP",
        "purpose": "Transform corresponding array elements.",
        "syntax": "=MAP(array1, [array2, ...], lambda)",
        "arguments": "array1 and optional aligned arrays supply values; the final LAMBDA has one parameter per array and returns one result per position.",
        "example": "=MAP({2;4},LAMBDA(item,item*3))",
        "result": "6 then 12",
        "useCase": "Apply a reusable margin calculation.",
        "mistake": "Each call must return one value; mismatched parameters error."
      }
    ],
    "combine": "Review SORT, UNIQUE, CHOOSECOLS, FILTER, ISNUMBER, ROUND, HSTACK, IF and SUMIFS. Practice combining at least four functions in the orientation-mean rule. Any equivalent formula is accepted. Numeric zero is measured, sample IDs remain text, and costs for Review pairs are pending. Training statuses do not authorize production release."
  },
  "orientationReshape": true,
