{
  "id": "L10-A3",
  "level": 10,
  "assignment": 3,
  "title": "Audit a guarded formula chain",
  "formulas": [
    "LET",
    "ROUND"
  ],
  "minutes": 90,
  "scenario": "Rervani Costing has 36 fictitious inspection jobs, quoted costs and a Rates table. A rate is usable only when its grade key is unique; blank mass is unknown and numeric zero is valid. Correct cost is mass × unique rate, rounded to cents; a rounded quoted-minus-correct difference over 0.01 CAD in magnitude is Mismatch.",
  "lesson": {
    "intro": "A formula audit compares a corrected calculation with an independent quoted value. Keep ambiguous mappings and missing inputs visible before deciding whether a cost matches.",
    "functions": [
      {
        "name": "LET",
        "purpose": "Name intermediate expressions.",
        "syntax": "=LET(name1, name_value1, [name2, name_value2], ..., calculation)",
        "arguments": "Provide a valid name/value pair, optional further pairs, and the final expression using those names; up to 126 pairs.",
        "example": "=LET(amount,12,fee,3,amount-fee)",
        "result": 9,
        "useCase": "Calculate a guarded yield once.",
        "mistake": "Names cannot collide with cell references; the last argument returns the result."
      },
      {
        "name": "ROUND",
        "purpose": "Round to a stated precision.",
        "syntax": "=ROUND(number, num_digits)",
        "arguments": "number is the result; num_digits is decimal places (negative for places left of the decimal point).",
        "example": "=ROUND(12.346,2)",
        "result": 12.35,
        "useCase": "Present currency or replicate means.",
        "mistake": "Round at the specified stage; display formatting does not change the value."
      }
    ],
    "combine": "Review COUNTIFS, XLOOKUP, ISNUMBER, ABS, FILTER and SORT. Practice combining at least four functions in the guarded cost rule. Missing mass or absent/duplicate rates produce Review. Quotes are numeric. Any equivalent formula is accepted."
  },
  "tasks": [
    {
      "prompt": "For the first eight jobs, return corrected cost rounded to cents, or Review for absent/ambiguous rate or missing mass.",
      "output": "Answers!B2:B9",
      "type": "array",
      "formulas": [
        "LET",
        "COUNTIFS",
        "IF",
        "ISNUMBER",
        "ROUND",
        "XLOOKUP"
      ],
      "id": "t1"
    },
    {
      "prompt": "For every job, return Review for an unavailable corrected cost; otherwise Mismatch when |ROUND(quoted − corrected,2)| > 0.01, or Match when ≤ 0.01. Source order (36 × 1).",
      "output": "Answers!B12:B47",
      "type": "array",
      "formulas": [
        "LET",
        "IF",
        "ABS",
        "ROUND",
        "XLOOKUP"
      ],
      "id": "t2"
    },
    {
      "prompt": "Return Job_no, Corrected_CAD, Quoted_CAD and Status for all Review/Mismatch jobs, sorted by Job_no ascending. Unavailable corrected cost is the text Review. No headers.",
      "output": "Answers!B50:E72",
      "type": "array",
      "formulas": [
        "LET",
        "XLOOKUP",
        "FILTER",
        "HSTACK",
        "SORT"
      ],
      "id": "t3"
    },
    {
      "prompt": "Return the total corrected cost for jobs with unique rates and numeric mass. Exclude Review jobs; sum costs after each row is rounded to cents.",
      "output": "Answers!B75",
      "type": "number",
      "formulas": [
        "SUM",
        "MAP",
        "LAMBDA",
        "ROUND"
      ],
      "id": "t4"
    }
  ],
