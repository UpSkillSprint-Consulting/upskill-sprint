{
  "id": "L8-A3",
  "level": 8,
  "assignment": 3,
  "title": "Score repeated readings row by row",
  "formulas": [
    "BYROW",
    "BYCOL"
  ],
  "minutes": 70,
  "scenario": "Hervali Lab has 40 fictitious samples with three energy readings each. Blank is unmeasured; zero is a measured result. Row minimum and mean are available only when all three readings are numeric; the training pass count is the number of numeric readings ≥ 27 J.",
  "lesson": {
    "intro": "Row-wise calculations summarize one sample at a time. Column-wise calculations summarize a reading position across samples. Both helpers require a scalar result for each call.",
    "functions": [
      {
        "name": "BYROW",
        "purpose": "Calculate one result per row.",
        "syntax": "=BYROW(array, lambda(row))",
        "arguments": "array supplies rows; lambda receives one row and must return one scalar.",
        "example": "=BYROW({2,4;3,7},LAMBDA(readings,SUM(readings)))",
        "result": "6 then 10",
        "useCase": "Score repeated sample readings.",
        "mistake": "Returning multiple cells per row creates #CALC!."
      },
      {
        "name": "BYCOL",
        "purpose": "Calculate one result per column.",
        "syntax": "=BYCOL(array, lambda(column))",
        "arguments": "array supplies columns; lambda receives one column and returns one scalar.",
        "example": "=BYCOL({2,4;3,7},LAMBDA(readings,SUM(readings)))",
        "result": "5, 11",
        "useCase": "Summarize reading positions.",
        "mistake": "Column summaries and row summaries have different shapes."
      }
    ],
    "combine": "Review COUNT, MIN, AVERAGE, SUM and ROUND. Guard complete-row metrics with COUNT=3. For column means, ignore blanks and retain zeros. Any valid formula is accepted; source order is the output order."
  },
  "tasks": [
    {
