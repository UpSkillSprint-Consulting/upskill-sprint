{
  "id": "L5-A4",
  "level": 5,
  "assignment": 4,
  "title": "Analyze completed employee service",
  "formulas": [
    "DATEDIF",
    "WEEKNUM"
  ],
  "minutes": 70,
  "scenario": "Norvella Business Support has 56 invented employment records. Use the fixed reporting date October 1, 2026, not today. Dates are provided as explicit components; completed years/months exclude partial intervals.",
  "lesson": {
    "intro": "Completed service is a calendar calculation. Use a fixed reporting date so the assignment’s answer remains reproducible. Calendar week rules must also be stated explicitly.",
    "functions": [
      {
        "name": "DATEDIF",
        "purpose": "Count complete date intervals.",
        "syntax": "=DATEDIF(start_date, end_date, unit)",
        "arguments": "Use ordered dates and quoted unit \"Y\" for complete years or \"M\" for complete months.",
        "example": "=DATEDIF(DATE(2024,6,15),DATE(2026,6,14),\"Y\")",
        "result": 1,
        "useCase": "Calculate completed employee service years.",
        "mistake": "End before start errors. Avoid the problematic MD unit; years are not elapsed days divided by 365."
      },
      {
        "name": "WEEKNUM",
        "purpose": "Assign a calendar week number.",
        "syntax": "=WEEKNUM(serial_number, [return_type])",
        "arguments": "serial_number is a date; return_type 2 means Monday-start weeks with the week containing January 1 as week 1.",
        "example": "=WEEKNUM(DATE(2026,1,1),2)",
        "result": 1,
        "useCase": "Group activity into stated calendar weeks.",
        "mistake": "Return type 2 is not ISO week numbering; ISO uses return type 21."
      }
    ],
    "combine": "Reuse DATE, IF and COUNTIFS. WEEKNUM return type 2 uses Monday-start weeks with the week containing January 1 numbered one; it is not ISO numbering. DATEDIF Y/M avoids the problematic MD unit."
  },
  "tasks": [
    {
      "prompt": "For the first six employees, return completed years of service through October 1, 2026.",
      "output": "Answers!B2:B7",
      "type": "array",
      "formulas": [
        "DATEDIF",
        "DATE"
      ],
      "id": "t1"
    },
    {
      "prompt": "For the first six employees, return completed months of service through the same fixed date.",
      "output": "Answers!B10:B15",
      "type": "array",
      "formulas": [
        "DATEDIF",
        "DATE"
      ],
      "id": "t2"
    },
    {
      "prompt": "For the first six start dates, return Monday-start calendar week numbers under WEEKNUM return type 2.",
      "output": "Answers!B18:B23",
      "type": "array",
      "formulas": [
        "WEEKNUM",
        "DATE"
      ],
      "id": "t3"
    },
    {
      "prompt": "For the first six employees, return Established for at least three completed years, otherwise Developing.",
      "output": "Answers!B26:B31",
      "type": "array",
      "formulas": [
        "IF",
        "DATEDIF",
        "DATE"
      ],
      "id": "t4"
    }
  ],
