{
  "id": "L10-A4",
  "level": 10,
  "assignment": 4,
  "title": "Create a formula-driven business dashboard",
  "formulas": [
    "LET",
    "MAP"
  ],
  "minutes": 95,
  "scenario": "Selvani Supplies has 45 fictitious monthly sales lines. Returns reverse units, revenue and per-unit cost; net units may be negative and must be preserved. Revenue = net units × selling price; profit = net units × (price − unit cost).",
  "lesson": {
    "intro": "A dashboard combines traceable metrics at a common grouping level. A ratio such as margin belongs to the grouped totals rather than an average of line margins.",
    "functions": [
      {
        "name": "LET",
        "purpose": "Name intermediate expressions.",
        "syntax": "=LET(name1, name_value1, [name2, name_value2], ..., calculation)",
        "arguments": "Provide a valid name/value pair, optional further pairs, and the final expression using those names; up to 126 pairs.",
        "example": "=LET(amount,12,fee,3,amount-fee)",
        "result": 9,
        "useCase": "Calculate a guarded yield once.",
        "mistake": "Names cannot collide with cell references; the last argument returns the result."
      },
      {
        "name": "MAP",
        "purpose": "Transform corresponding array elements.",
        "syntax": "=MAP(array1, [array2, ...], lambda)",
        "arguments": "array1 and optional aligned arrays supply values; the final LAMBDA has one parameter per array and returns one result per position.",
        "example": "=MAP({2;4},LAMBDA(item,item*3))",
        "result": "6 then 12",
        "useCase": "Apply a reusable margin calculation.",
        "mistake": "Each call must return one value; mismatched parameters error."
      }
    ],
    "combine": "Review SUMPRODUCT, HSTACK, FILTER, SORTBY and ROUND. Define net units once, aggregate by the Months/Product scaffold, and reconcile with independent raw calculations. Any equivalent formula is accepted; round money to cents and margin percentage numbers to two decimals."
  },
  "tasks": [
    {
      "prompt": "For the first eight lines, return Net_units, Net_revenue_CAD and Net_profit_CAD (8 × 3). Preserve negative net quantities; round money to cents.",
      "output": "Answers!B2:D9",
      "type": "array",
      "formulas": [
        "LET",
        "HSTACK",
        "ROUND"
      ],
      "id": "t1"
    },
    {
      "prompt": "Return Month, Net_units, Net_revenue_CAD, Net_profit_CAD and Margin_pct (3 × 5), Months order. Compute margin from monthly totals; Zero revenue for a zero monthly denominator.",
      "output": "Answers!B12:F14",
      "type": "array",
      "formulas": [
        "LET",
        "MAP",
        "SUMPRODUCT",
        "HSTACK",
        "ROUND",
        "IF"
      ],
      "id": "t2"
    },
    {
      "prompt": "Aggregate across all months and return loss-making Product plus Net_profit_CAD (two columns), sorted by profit ascending then Product ascending. Include only strictly negative product profit.",
      "output": "Answers!B17:C17",
      "type": "array",
      "formulas": [
        "LET",
        "MAP",
        "SUMPRODUCT",
        "FILTER",
        "SORTBY"
      ],
      "id": "t3"
    },
    {
      "prompt": "Return three independent reconciliations: monthly total net units minus raw net units, monthly revenue minus raw revenue, and monthly profit minus raw profit (1 × 3). Round money differences to cents; reconciled outputs are numeric zero.",
      "output": "Answers!B20:D20",
      "type": "array",
      "formulas": [
        "HSTACK",
        "SUM",
        "SUMPRODUCT",
        "ROUND"
      ],
      "id": "t4"
    }
  ],
