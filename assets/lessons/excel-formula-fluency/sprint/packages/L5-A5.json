      "prompt": "For the first six shifts, return the start time as text hh:mm.",
      "output": "Answers!B2:B7",
      "type": "array",
      "formulas": [
        "TIME",
        "TEXT"
      ],
      "id": "t1"
    },
    {
      "prompt": "For the first six shifts, calculate gross hours across midnight, rounded to two decimals.",
      "output": "Answers!B10:B15",
      "type": "array",
      "formulas": [
        "MOD",
        "TIME",
        "ROUND"
      ],
      "id": "t2"
    },
    {
      "prompt": "For the first six shifts, calculate net hours after subtracting Break_min once, rounded to two decimals.",
      "output": "Answers!B18:B23",
      "type": "array",
      "formulas": [
        "MOD",
        "TIME",
        "ROUND"
      ],
      "id": "t3"
    },
    {
      "prompt": "For the first six shifts, return Review if unrounded net hours strictly exceed 8, otherwise Standard.",
      "output": "Answers!B26:B31",
      "type": "array",
      "formulas": [
        "IF",
        "MOD",
        "TIME"
      ],
      "id": "t4"
    }
