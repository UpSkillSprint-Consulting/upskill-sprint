{
  "id": "L5-A5",
  "level": 5,
  "assignment": 5,
  "title": "Measure overnight production shifts",
  "formulas": [
    "TIME",
    "MOD"
  ],
  "minutes": 75,
  "scenario": "Orvani Rolling has 60 invented shifts with start/end hour and minute components. Every shift lasts under 24 hours; a lower end time means it crosses midnight. Unpaid break minutes are subtracted once, and training Review means net hours strictly above 8.",
  "lesson": {
    "intro": "Excel times are fractions of a day. An overnight subtraction can be negative, so use a remainder modulo one day and multiply by 24 for hours.",
    "functions": [
      {
        "name": "TIME",
        "purpose": "Construct a time from components.",
        "syntax": "=TIME(hour, minute, second)",
        "arguments": "Supply hours, minutes and seconds; output is a fraction of one day.",
        "example": "=TEXT(TIME(7,30,0),\"hh:mm\")",
        "result": "07:30",
        "useCase": "Build time values without locale-dependent text parsing.",
        "mistake": "Hours above 23 wrap; do not use TIME to preserve multi-day durations."
      },
      {
        "name": "MOD",
        "purpose": "Return the remainder after division.",
        "syntax": "=MOD(number, divisor)",
        "arguments": "number is the input and divisor the division base.",
        "example": "=MOD(3-22,24)",
        "result": 5,
        "useCase": "Calculate overnight duration for shifts shorter than 24 hours.",
        "mistake": "MOD hides whole days; it is inappropriate for multi-day durations."
      }
    ],
    "combine": "Reuse ROUND for reported hours and IF for the review flag. Divide break minutes by 60 before subtracting from hours. The stated under-24-hour assumption is essential: MOD cannot retain elapsed whole days."
  },
  "tasks": [
