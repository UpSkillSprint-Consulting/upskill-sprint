{
  "id": "L4-A4",
  "level": 4,
  "assignment": 4,
  "title": "Split and rebuild a manifest",
  "formulas": [
    "TEXTSPLIT",
    "TEXTJOIN"
  ],
  "minutes": 60,
  "scenario": "Irvella Dispatch has 56 invented manifests in the three-field pattern ORDER|ZONE|PRIORITY. Some Zone fields are intentionally empty; their field positions must be preserved. Blank zones receive Unknown in the standardized display.",
  "lesson": {
    "intro": "A split operation creates cells, while a join creates one text value. Empty-field handling controls whether the original schema remains intact.",
    "functions": [
      {
        "name": "TEXTSPLIT",
        "purpose": "Split text into a spilled array.",
        "syntax": "=TEXTSPLIT(text, col_delimiter, [row_delimiter], [ignore_empty], [match_mode], [pad_with])",
        "arguments": "Input and column delimiter are required. Optional row delimiter creates rows; ignore_empty omits empty fields, match_mode controls case and pad_with fills gaps.",
        "example": "=TEXTSPLIT(\"A|B|C\",\"|\")",
        "result": "A, B, C in three columns",
        "useCase": "Separate manifest fields.",
        "mistake": "Leave enough empty cells for the spill. Ignoring empty fields changes their positions."
      },
      {
        "name": "TEXTJOIN",
        "purpose": "Join values with a chosen separator.",
        "syntax": "=TEXTJOIN(delimiter, ignore_empty, text1, [text2], ...)",
        "arguments": "delimiter separates values; ignore_empty is TRUE/FALSE; remaining arguments supply text or ranges.",
        "example": "=TEXTJOIN(\" / \",TRUE,\"A\",\"\",\"B\")",
        "result": "A / B",
        "useCase": "Create readable lists.",
        "mistake": "Ignoring empty cells changes the output; choose deliberately."
      }
    ],
    "combine": "Reuse IF to handle empty zones and UPPER/TRIM to standardize display text. TEXTSPLIT ignore_empty FALSE preserves an empty middle field. TEXTJOIN ignore_empty TRUE deliberately removes empty entries from the readable summary."
  },
  "tasks": [
    {
      "prompt": "Split the first manifest into three columns: order, zone and priority. Preserve the empty zone as an empty cell.",
      "output": "Answers!B2:D2",
      "type": "array",
      "formulas": [
        "TEXTSPLIT"
      ],
      "id": "t1"
    },
    {
      "prompt": "For the second manifest, return a readable summary joined with the exact delimiter space / space, ignoring empty fields.",
      "output": "Answers!B5",
      "type": "text",
      "formulas": [
        "TEXTJOIN",
        "TEXTSPLIT"
      ],
      "id": "t2"
    },
    {
      "prompt": "For the first six manifests, return their middle zone; replace an empty zone with Unknown.",
      "output": "Answers!B8:B13",
      "type": "array",
      "formulas": [
        "IF",
        "INDEX",
        "TEXTSPLIT"
      ],
      "id": "t3"
    },
    {
      "prompt": "For the first manifest, rebuild all three fields using delimiter | and keeping empty fields; the result must equal the source.",
      "output": "Answers!B16",
      "type": "text",
      "formulas": [
        "TEXTJOIN",
        "TEXTSPLIT"
      ],
      "id": "t4"
    }
  ],
  "bonus": {
    "prompt": "Return the first manifest’s priority in uppercase.",
    "output": "Answers!B19",
    "type": "text",
    "formulas": [
      "UPPER",
      "INDEX",
      "TEXTSPLIT"
    ],
    "id": "bonus"
  },
