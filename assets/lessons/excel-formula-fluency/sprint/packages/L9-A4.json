{
  "id": "L9-A4",
  "level": 9,
  "assignment": 4,
  "title": "Explore paired correlations responsibly",
  "formulas": [
    "CORREL",
    "ISNUMBER"
  ],
  "minutes": 85,
  "scenario": "Nevrali Operations records 44 fictitious batches with production rate and energy per tonne. Some cells are unmeasured. Correlation uses only records with both values numeric; preserve row pairing, and describe association without claiming a causal effect.",
  "lesson": {
    "intro": "Correlation measures linear association for aligned pairs. Independently dropping missing values from each column breaks those pairs and can produce a misleading result.",
    "functions": [
      {
        "name": "CORREL",
        "purpose": "Measure linear association.",
        "syntax": "=CORREL(array1, array2)",
        "arguments": "Supply aligned numeric pairs; both arrays require equal length and nonzero variation.",
        "example": "=CORREL({1;2;3},{3;6;9})",
        "result": 1,
        "useCase": "Explore paired operating variables.",
        "mistake": "Filter both arrays with the same completeness mask. Correlation does not establish causation."
      },
      {
        "name": "ISNUMBER",
        "purpose": "Test the stored value type.",
        "syntax": "=ISNUMBER(value)",
        "arguments": "value is the cell or expression to test.",
        "example": "=ISNUMBER(0)",
        "result": true,
        "useCase": "Keep measured zero and exclude blank results.",
        "mistake": "A numeric-looking text string is not a number."
      }
    ],
    "combine": "Review LET, FILTER, ABS and IF. Create one complete-pair mask for both arrays. For this exercise only, |r| ≥ 0.5 receives the label Association only; below it receives Weak association. Neither label proves causation. Any valid formula is accepted."
  },
  "tasks": [
    {
      "prompt": "Count complete numeric pairs across all 44 records.",
      "output": "Answers!B2",
      "type": "number",
      "formulas": [
        "SUMPRODUCT",
        "ISNUMBER"
      ],
      "id": "t1"
    },
    {
      "prompt": "Return Pearson correlation using complete pairs only. Submit unrounded r.",
      "output": "Answers!B5",
      "type": "number",
      "formulas": [
        "CORREL",
        "LET",
        "FILTER"
      ],
      "id": "t2"
    },
    {
      "prompt": "For the first eight records, return Paired when both cells are numeric; otherwise Missing pair (8 × 1).",
      "output": "Answers!B8:B15",
      "type": "array",
      "formulas": [
        "IF",
        "AND",
        "ISNUMBER"
      ],
      "id": "t3"
    },
    {
      "prompt": "Using unrounded task-2 r, return Association only when |r| ≥ 0.5; otherwise Weak association. This is a practice description, not a causal conclusion.",
      "output": "Answers!B18",
      "type": "text",
      "formulas": [
        "IF",
        "ABS"
      ],
      "id": "t4"
    }
  ],
