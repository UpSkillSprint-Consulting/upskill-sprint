{
  "id": "L7-A5",
  "level": 7,
  "assignment": 5,
  "title": "Filter a full quality exception report",
  "formulas": [
    "FILTER",
    "SORTBY"
  ],
  "minutes": 70,
  "scenario": "Elvani Pipeworks has 60 fictitious inspections. Training thickness is 9.5–10.5 mm inclusive and strength is at least 450 MPa. Blank strength means Review; measured failures mean Hold; all others are Pass. Repeat heats retain every inspection.",
  "lesson": {
    "intro": "A compound filter can retain several kinds of exception while preserving source records. Sort the resulting report using keys taken from the same filtered population.",
    "functions": [
      {
        "name": "FILTER",
        "purpose": "Select records with a Boolean mask.",
        "syntax": "=FILTER(array, include, [if_empty])",
        "arguments": "array is the source; include is an aligned row/column mask; optional if_empty supplies a deliberate fallback.",
        "example": "=FILTER({5;8;2},{TRUE;FALSE;TRUE},\"None\")",
        "result": "5 then 2",
        "useCase": "Build a quality exception queue.",
        "mistake": "Use multiplication for AND and addition for OR; errors in the mask propagate."
      },
      {
        "name": "SORTBY",
        "purpose": "Sort using aligned keys.",
        "syntax": "=SORTBY(array, by_array1, [sort_order1], [by_array2], [sort_order2], ...)",
        "arguments": "Supply output and sort keys; optional order is 1 ascending or -1 descending; additional key/order pairs resolve ties.",
        "example": "=SORTBY({\"A\";\"B\"},{2;1},1)",
        "result": "B then A",
        "useCase": "Order exceptions by cost and identifier.",
        "mistake": "Sort keys must describe the same filtered records."
      }
    ],
    "combine": "Review IF, ISNUMBER, CHOOSECOLS and SUMIFS. Use a nested FILTER to select one heat from a broader exception set. Any valid formula is accepted; results have no headers and use the order specified by each task."
  },
  "tasks": [
    {
      "prompt": "For every source record, return Pass, Hold or Review (60 × 1), in source order.",
      "output": "Answers!B2:B61",
      "type": "array",
      "formulas": [
        "IF",
        "ISNUMBER"
      ],
      "id": "t1"
    },
    {
      "prompt": "Return every full Data row whose task-1 status is Hold or Review, sorted by Inspection_no ascending. Keep repeated heats.",
      "output": "Answers!B64:F90",
      "type": "array",
      "formulas": [
        "FILTER",
        "SORTBY"
      ],
      "id": "t2"
    },
    {
      "prompt": "Calculate total Rework_CAD for Hold records only. Review costs are pending and excluded.",
      "output": "Answers!B93",
      "type": "number",
      "formulas": [
        "SUMIFS"
      ],
      "id": "t3"
    },
    {
      "prompt": "From the full exception population, return full Data rows for heat EV-H2 in source order. Use nested filtering; any equivalent formula is accepted.",
      "output": "Answers!B96:F101",
      "type": "array",
      "formulas": [
        "FILTER"
      ],
      "id": "t4"
    }
  ],
