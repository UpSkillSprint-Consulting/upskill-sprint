{
  "id": "L9-A5",
  "level": 9,
  "assignment": 5,
  "title": "Calculate capability under stated assumptions",
  "formulas": [
    "STDEV.S",
    "AVERAGE"
  ],
  "minutes": 90,
  "scenario": "Orvani Lab provides 50 fictitious independent thickness observations. For illustration, assume a stable normal process and a separately supplied within-process sigma of 0.06 mm; these assumptions are not demonstrated by this sample. Specification limits and historical reference mean are on Assumptions.",
  "lesson": {
    "intro": "Sample spread and an assumed within-process sigma serve different purposes. Cp compares specification width with six sigma; Cpk also accounts for the sample mean’s distance from either specification.",
    "functions": [
      {
        "name": "STDEV.S",
        "purpose": "Estimate sample standard deviation.",
        "syntax": "=STDEV.S(number1, [number2], ...)",
        "arguments": "number1 is a numeric sample or range; optional arguments add observations; the denominator is n−1.",
        "example": "=STDEV.S(8,10,12)",
        "result": 2,
        "useCase": "Describe observed variation.",
        "mistake": "At least two numeric values are needed. Sample spread does not prove stability."
      },
      {
        "name": "AVERAGE",
        "purpose": "Calculate the arithmetic mean.",
        "syntax": "=AVERAGE(number1, [number2], ...)",
        "arguments": "number1 supplies a value/range; optional arguments add observations.",
        "example": "=AVERAGE(8,10,12)",
        "result": 10,
        "useCase": "Estimate a training sample mean.",
        "mistake": "Blanks are excluded and numeric zero is included."
      }
    ],
    "combine": "Review MIN and ROUND. Cp=(USL−LSL)/(6×sigma); Cpk=MIN((USL−mean)/(3×sigma),(mean−LSL)/(3×sigma)). Reference control limits are historical mean ± 3×sigma, for individual observations. They are not specification limits. These illustrative indices do not prove stability or production acceptance. Any valid formula is accepted."
  },
  "tasks": [
    {
      "prompt": "Return sample mean and sample STDEV.S as one 1 × 2 row. Submit both unrounded, in mm.",
      "output": "Answers!B2:C2",
      "type": "array",
      "formulas": [
        "AVERAGE",
        "STDEV.S",
        "HSTACK"
      ],
      "id": "t1"
    },
    {
      "prompt": "Calculate illustrative Cp using the supplied within-process sigma, not task-1 sample spread. Submit unrounded.",
      "output": "Answers!B5",
      "type": "number",
      "formulas": [
        "SUM"
      ],
      "id": "t2"
    },
    {
      "prompt": "Calculate illustrative Cpk using the task-1 mean and supplied within-process sigma. Submit unrounded.",
      "output": "Answers!B8",
      "type": "number",
      "formulas": [
        "MIN"
      ],
      "id": "t3"
    },
    {
      "prompt": "Return lower and upper historical-reference control limits as one 1 × 2 row: Reference_mean_mm ± 3 × Within_sigma_mm. Round to three decimals. These are for individual observations, not subgroup averages.",
      "output": "Answers!B11:C11",
      "type": "array",
      "formulas": [
        "HSTACK",
        "ROUND"
      ],
      "id": "t4"
    }
  ],
  "bonus": {
    "prompt": "Review COUNTIFS: count sample thicknesses outside the inclusive specification limits.",
    "output": "Answers!B14",
