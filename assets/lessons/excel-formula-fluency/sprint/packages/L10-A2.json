{
  "id": "L10-A2",
  "level": 10,
  "assignment": 2,
  "title": "Reconcile orders and partial shipments",
  "formulas": [
    "LET",
    "MAP"
  ],
  "minutes": 85,
  "scenario": "Qervali Distribution has 40 fictitious orders and a Shipments table with partial and repeated dispatches. Aggregate all shipments by Order_no; shipments for absent orders are orphans and remain separate. Remaining units = ordered − shipped; negative means overshipment and must not be clamped to zero.",
  "lesson": {
    "intro": "Reconciling tables requires aggregate joins when an order can have several shipments. A first-match lookup loses partial dispatches. Independent control totals expose orphan movements.",
    "functions": [
      {
        "name": "LET",
        "purpose": "Name intermediate expressions.",
        "syntax": "=LET(name1, name_value1, [name2, name_value2], ..., calculation)",
        "arguments": "Provide a valid name/value pair, optional further pairs, and the final expression using those names; up to 126 pairs.",
        "example": "=LET(amount,12,fee,3,amount-fee)",
        "result": 9,
        "useCase": "Calculate a guarded yield once.",
        "mistake": "Names cannot collide with cell references; the last argument returns the result."
      },
      {
        "name": "MAP",
        "purpose": "Transform corresponding array elements.",
        "syntax": "=MAP(array1, [array2, ...], lambda)",
        "arguments": "array1 and optional aligned arrays supply values; the final LAMBDA has one parameter per array and returns one result per position.",
        "example": "=MAP({2;4},LAMBDA(item,item*3))",
        "result": "6 then 12",
        "useCase": "Apply a reusable margin calculation.",
        "mistake": "Each call must return one value; mismatched parameters error."
      }
    ],
    "combine": "Review SUMIFS, COUNTIFS, FILTER, HSTACK and SUM. Use the order scaffold to preserve source order. Return Short for positive remaining units, Over for negative, Balanced for zero. Any equivalent formula is accepted; all quantities are numeric."
  },
  "tasks": [
    {
      "prompt": "Return total shipped units for the first eight order rows (8 × 1). Sum every partial shipment; absent shipments produce numeric zero.",
      "output": "Answers!B2:B9",
      "type": "array",
      "formulas": [
        "MAP",
        "LAMBDA",
        "SUMIFS"
      ],
      "id": "t1"
    },
    {
      "prompt": "Return Order_no, Ordered_units, Shipped_units, Remaining_units, Status for every order (40 × 5), source order. Preserve signed remaining units.",
      "output": "Answers!B12:F51",
      "type": "array",
      "formulas": [
        "LET",
        "MAP",
        "SUMIFS",
        "HSTACK",
        "IF"
      ],
      "id": "t2"
    },
    {
      "prompt": "From task 2, return every Short or Over row in original order order, without headers. Balanced rows are excluded.",
      "output": "Answers!B54:F84",
      "type": "array",
      "formulas": [
        "FILTER"
      ],
      "id": "t3"
    },
    {
      "prompt": "Return total ordered units, matched shipped units, orphan shipped units, and all shipped units − matched − orphan as one 1 × 4 row. The last value must reconcile to numeric zero.",
      "output": "Answers!B87:E87",
      "type": "array",
      "formulas": [
        "LET",
        "COUNTIFS",
        "FILTER",
        "HSTACK",
        "SUM"
      ],
      "id": "t4"
    }
  ],
