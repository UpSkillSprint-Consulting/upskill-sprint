{
  "id": "L10-A1",
  "level": 10,
  "assignment": 1,
  "title": "Build a robust inspection summary",
  "formulas": [
    "LET",
    "FILTER"
  ],
  "minutes": 80,
  "scenario": "Pelvani Pipeworks records 60 fictitious inspections. Specs includes one deliberately duplicated grade; an absent/ambiguous grade or blank strength means Review. A unique specification and numeric strength produce Released at/above the training minimum, otherwise Hold.",
  "lesson": {
    "intro": "An integrated report should make input guards visible before a comparison. A successful lookup can still select an ambiguous specification unless cardinality is checked.",
    "functions": [
      {
        "name": "LET",
        "purpose": "Name intermediate expressions.",
        "syntax": "=LET(name1, name_value1, [name2, name_value2], ..., calculation)",
        "arguments": "Provide a valid name/value pair, optional further pairs, and the final expression using those names; up to 126 pairs.",
        "example": "=LET(amount,12,fee,3,amount-fee)",
        "result": 9,
        "useCase": "Calculate a guarded yield once.",
        "mistake": "Names cannot collide with cell references; the last argument returns the result."
      },
      {
        "name": "FILTER",
        "purpose": "Select records with a Boolean mask.",
        "syntax": "=FILTER(array, include, [if_empty])",
        "arguments": "array is the source; include is an aligned row/column mask; optional if_empty supplies a deliberate fallback.",
        "example": "=FILTER({5;8;2},{TRUE;FALSE;TRUE},\"None\")",
        "result": "5 then 2",
        "useCase": "Build a quality exception queue.",
        "mistake": "Use multiplication for AND and addition for OR; errors in the mask propagate."
      }
    ],
    "combine": "Review COUNTIFS, XLOOKUP, ISNUMBER, IF, HSTACK and SORTBY. Build a nested rule using at least four functions, then reuse its statuses for summaries and queues. Any equivalent formula is accepted. Training rules do not authorize production release."
  },
  "tasks": [
    {
      "prompt": "For the first eight rows, return a unique grade’s minimum strength or Review for an absent/duplicated key (8 × 1).",
      "output": "Answers!B2:B9",
      "type": "array",
      "formulas": [
        "LET",
        "COUNTIFS",
        "IF",
        "XLOOKUP"
      ],
      "id": "t1"
    },
    {
      "prompt": "Return Released, Hold or Review for all 60 inspections in source order. Equality to a unique minimum is Released; blank strength is Review.",
      "output": "Answers!B12:B71",
      "type": "array",
      "formulas": [
        "LET",
        "COUNTIFS",
        "ISNUMBER",
        "IF",
        "XLOOKUP"
      ],
      "id": "t2"
    },
    {
      "prompt": "Return Released count, Hold count, Review count and total Hold_cost_CAD for Hold rows as one 1 × 4 row. Review costs are pending and excluded.",
      "output": "Answers!B74:E74",
      "type": "array",
      "formulas": [
        "HSTACK",
        "COUNTIFS",
        "SUMIFS"
      ],
      "id": "t3"
    },
    {
      "prompt": "Return full Data rows for Hold inspections, sorted by Hold_cost_CAD descending then Inspection_no ascending. No headers.",
      "output": "Answers!B77:E87",
      "type": "array",
      "formulas": [
        "LET",
        "FILTER",
        "SORTBY",
        "CHOOSECOLS"
      ],
      "id": "t4"
    }
  ],
  "bonus": {
    "prompt": "Review SUM: subtract the independent raw Hold-cost sum from the summary Hold cost; return numeric zero when reconciled.",
    "output": "Answers!B90",
    "type": "number",
    "formulas": [
      "SUMIFS"
    ],
    "id": "bonus"
  },
