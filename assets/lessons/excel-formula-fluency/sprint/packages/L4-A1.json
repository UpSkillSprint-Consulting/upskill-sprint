{
  "id": "L4-A1",
  "level": 4,
  "assignment": 1,
  "title": "Clean inspection identifiers",
  "formulas": [
    "TRIM",
    "CLEAN",
    "UPPER"
  ],
  "minutes": 45,
  "scenario": "Felnori Mill has 44 invented imported inspection IDs. ASCII tab characters, ordinary outer spaces and inconsistent letter case are deliberate; no nonbreaking spaces occur. Repeated canonical IDs are legitimate retests and must remain separate records.",
  "lesson": {
    "intro": "Cleaning should target the actual messiness. Remove ASCII control characters, collapse ordinary spaces, then standardize case. Keep the raw identifier so the transformation can be traced.",
    "functions": [
      {
        "name": "TRIM",
        "purpose": "Remove outer spaces and repeated ordinary spaces.",
        "syntax": "=TRIM(text)",
        "arguments": "text is the string or cell to clean.",
        "example": "=TRIM(\"  A   B  \")",
        "result": "A B",
        "useCase": "Normalize imported identifiers.",
        "mistake": "Nonbreaking spaces are not ordinary spaces; replace them deliberately."
      },
      {
        "name": "CLEAN",
        "purpose": "Remove ASCII control characters.",
        "syntax": "=CLEAN(text)",
        "arguments": "text is the string or reference containing unwanted control characters.",
        "example": "=CLEAN(\"A\"&CHAR(9)&\"B\")",
        "result": "AB",
        "useCase": "Remove tabs from exported codes.",
        "mistake": "CLEAN does not remove every Unicode invisible character."
      },
      {
        "name": "UPPER",
        "purpose": "Convert letters to uppercase.",
        "syntax": "=UPPER(text)",
        "arguments": "text is the input string or cell.",
        "example": "=UPPER(\"ab-7\")",
        "result": "AB-7",
        "useCase": "Make a canonical product key.",
        "mistake": "It does not remove spaces or change numeric values."
      }
    ],
    "combine": "Reuse IF for a classification after cleaning and COUNTA for record counts. CLEAN and TRIM solve different problems; nesting them in the wrong order may preserve a separator you meant to remove."
  },
  "tasks": [
    {
      "prompt": "For the first six records, remove ASCII control characters, trim ordinary spaces and return uppercase canonical inspection IDs.",
      "output": "Answers!B2:B7",
      "type": "array",
      "formulas": [
        "UPPER",
        "TRIM",
        "CLEAN"
      ],
      "id": "t1"
    },
    {
      "prompt": "Remove control characters and outer ordinary spaces from the first raw ID, preserving its original letter case.",
      "output": "Answers!B10",
      "type": "text",
      "formulas": [
        "TRIM",
        "CLEAN"
      ],
      "id": "t2"
    },
    {
      "prompt": "For the first six records, return Retest when the canonical uppercase ID is FN-101, otherwise Other.",
      "output": "Answers!B13:B18",
      "type": "array",
      "formulas": [
        "IF",
        "UPPER",
        "TRIM",
        "CLEAN"
      ],
      "id": "t3"
    },
    {
      "prompt": "Count populated raw inspection ID cells across all 44 rows. Retests still count as records.",
      "output": "Answers!B21",
      "type": "number",
      "formulas": [
        "COUNTA"
      ],
      "id": "t4"
    }
  ],
  "bonus": {
    "prompt": "Return the first cleaned uppercase ID followed by the literal text |CHECK.",
    "output": "Answers!B24",
    "type": "text",
    "formulas": [
      "UPPER",
      "TRIM",
      "CLEAN"
    ],
    "id": "bonus"
  },
