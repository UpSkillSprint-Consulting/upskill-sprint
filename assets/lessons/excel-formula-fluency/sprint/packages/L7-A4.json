{
  "id": "L7-A4",
  "level": 7,
  "assignment": 4,
  "title": "Match specifications in two dimensions",
  "formulas": [
    "XMATCH",
    "INDEX"
  ],
  "minutes": 65,
  "scenario": "Dorlavi Inspection has 36 fictitious Charpy records and a grade-by-orientation Matrix. A blank or unlisted grade/orientation returns Missing. The matrix limits are training assumptions; a measured energy at or above its unique limit is Pass.",
  "lesson": {
    "intro": "Two-way matching selects a row key and a column key independently. Exact matching should find named dimensions rather than relying on their current order.",
    "functions": [
      {
        "name": "XMATCH",
        "purpose": "Find a relative position.",
        "syntax": "=XMATCH(lookup_value, lookup_array, [match_mode], [search_mode])",
        "arguments": "Supply key and one-dimensional range; match mode 0 exact, -1 next smaller, 1 next larger, 2 wildcard; search 1 forward, -1 reverse, 2 ascending binary, -2 descending binary.",
        "example": "=XMATCH(\"B\",{\"A\",\"B\"},0,1)",
        "result": 2,
        "useCase": "Match both dimensions of a specification.",
        "mistake": "Binary modes require sorted keys. A first match does not prove uniqueness."
      },
      {
        "name": "INDEX",
        "purpose": "Select a row and column.",
        "syntax": "=INDEX(array, row_num, [column_num])",
        "arguments": "array is the source; row_num and optional column_num are positions within it.",
        "example": "=INDEX({7,9;11,13},2,1)",
        "result": 11,
        "useCase": "Read a two-dimensional training matrix.",
        "mistake": "Worksheet row numbers differ from positions within the array."
      }
    ],
    "combine": "Review IFNA, IF and COUNTIFS. Place two exact XMATCH positions inside INDEX. Check energy availability before comparing; a missing measurement must remain Missing. Any valid formula is accepted."
  },
  "tasks": [
    {
      "prompt": "For the first eight records, return the exact grade position within Matrix data rows, or Missing for an absent grade.",
      "output": "Answers!B2:B9",
      "type": "array",
      "formulas": [
        "XMATCH",
        "IFNA"
      ],
      "id": "t1"
    },
    {
      "prompt": "For the first eight records, return the matched energy limit in joules, or Missing if either dimension is absent.",
      "output": "Answers!B12:B19",
      "type": "array",
      "formulas": [
        "INDEX",
        "XMATCH",
        "IFNA"
      ],
      "id": "t2"
    },
    {
      "prompt": "For the first eight records, return Pass when measured energy is at least the matched limit, Hold below it, or Missing for absent energy/dimensions.",
      "output": "Answers!B22:B29",
      "type": "array",
      "formulas": [
        "IF",
        "ISNUMBER"
      ],
      "id": "t3"
    },
    {
