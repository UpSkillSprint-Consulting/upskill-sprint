{
  "id": "L5-A3",
  "level": 5,
  "assignment": 3,
  "title": "Calculate working-day review deadlines",
  "formulas": [
    "WORKDAY",
    "NETWORKDAYS"
  ],
  "minutes": 65,
  "scenario": "Melvani Process Lab has 52 invented review starts and target working-day durations. Only the two dates in Holidays are excluded; they are invented shutdown days, not a statutory holiday calendar. Saturday and Sunday are weekends.",
  "lesson": {
    "intro": "A working-day offset and an inclusive count answer different questions. The start day is excluded from WORKDAY’s positive offset, but included in NETWORKDAYS when eligible.",
    "functions": [
      {
        "name": "WORKDAY",
        "purpose": "Move by working days.",
        "syntax": "=WORKDAY(start_date, days, [holidays])",
        "arguments": "Start date and signed working-day offset are required; holidays optionally excludes dates.",
        "example": "=TEXT(WORKDAY(DATE(2026,9,7),5),\"yyyy-mm-dd\")",
        "result": "2026-09-14",
        "useCase": "Calculate a processing deadline.",
        "mistake": "The start day is not day 1 of the offset. It differs from inclusive NETWORKDAYS."
      },
      {
        "name": "NETWORKDAYS",
        "purpose": "Count working days inclusively.",
        "syntax": "=NETWORKDAYS(start_date, end_date, [holidays])",
        "arguments": "Start and end dates are required. Optional holidays lists excluded dates; Saturday/Sunday are weekends.",
        "example": "=NETWORKDAYS(DATE(2026,9,7),DATE(2026,9,11))",
        "result": 5,
        "useCase": "Measure an inclusive review window.",
        "mistake": "Both endpoints count when they are working days. Holiday dates must be real dates."
      }
    ],
    "combine": "Reuse DATE and TEXT. Build the Holidays cells into real Excel dates from the supplied components; text formatted to look like a date is insufficient. Reuse IF to flag a working-day count above a stated limit."
  },
  "tasks": [
    {
      "prompt": "First create Holidays!E2:E3 as real dates using the Year/Month/Day components in B:D. Then return those two dates as ISO text in their source order.",
      "output": "Answers!B2:B3",
      "type": "array",
      "formulas": [
        "DATE",
        "TEXT"
      ],
      "id": "t1"
    },
    {
      "prompt": "For the first six reviews, return the deadline Target_workdays working days after the start date, excluding the stated shutdown dates. Submit ISO text.",
      "output": "Answers!B6:B11",
      "type": "array",
      "formulas": [
        "WORKDAY",
        "DATE",
        "TEXT"
      ],
      "id": "t2"
    },
    {
      "prompt": "For the first six reviews, count working days inclusively from the start date through the computed deadline, excluding the stated shutdowns.",
      "output": "Answers!B14:B19",
      "type": "array",
      "formulas": [
        "NETWORKDAYS",
        "WORKDAY",
        "DATE"
      ],
      "id": "t3"
    },
    {
      "prompt": "For the first six reviews, return Extended when the inclusive working-day count exceeds 6, otherwise Standard.",
      "output": "Answers!B22:B27",
      "type": "array",
      "formulas": [
        "IF",
        "NETWORKDAYS",
        "WORKDAY"
      ],
      "id": "t4"
    }
  ],
  "bonus": {
    "prompt": "Return the first review’s deadline with no shutdown exclusions, as ISO text.",
    "output": "Answers!B30",
    "type": "text",
    "formulas": [
      "WORKDAY",
      "DATE",
      "TEXT"
    ],
    "id": "bonus"
  },
