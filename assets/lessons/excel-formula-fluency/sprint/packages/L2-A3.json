{
  "id": "L2-A3",
  "level": 2,
  "assignment": 3,
  "title": "Sales with multiple conditions",
  "formulas": [
    "SUMIFS",
    "COUNTIFS"
  ],
  "minutes": 45,
  "scenario": "Averiq Stationery is reviewing 26 fictitious September sales lines. The commercial team needs results for a region, channel and product category together. Revenue already represents the whole sales line, so it must not be multiplied by units again.",
  "lesson": {
    "intro": "Conditional aggregation screens rows first and then summarizes only matching rows. Multiple criterion pairs operate as AND. Keep every result and criterion range aligned to the same data rows.",
    "functions": [
      {
        "name": "SUMIFS",
        "purpose": "Add numeric values whose rows meet every criterion.",
        "syntax": "=SUMIFS(sum_range, criteria_range1, criteria1, [criteria_range2, criteria2], ...)",
        "arguments": "sum_range holds values; each criteria_range and criteria pair screens the corresponding rows.",
        "example": "=SUMIFS(D2:D4,B2:B4,\"Cove\")",
        "result": "320 when D2:D4 contains 120,80,200 and B2:B4 contains Cove,Vale,Cove",
        "useCase": "Sum revenue for a region and channel.",
        "mistake": "The sum range comes first, and all ranges need matching size and row alignment."
      },
      {
        "name": "COUNTIFS",
        "purpose": "Count rows that satisfy every criterion.",
        "syntax": "=COUNTIFS(criteria_range1, criteria1, [criteria_range2, criteria2], ...)",
        "arguments": "Each range/criterion pair adds a required condition; subsequent pairs are optional.",
        "example": "=COUNTIFS(B2:B4,\"Cove\")",
        "result": "2 when B2:B4 contains Cove,Vale,Cove",
        "useCase": "Count matching orders or inspected samples.",
        "mistake": "COUNTIFS counts rows, not units. Quote criteria such as \">=500\"."
      }
    ],
    "combine": "Reuse ROUND and IFERROR when dividing conditional revenue by conditional row count. A criterion written as \">=\"&cell connects an operator to a cell value. Apply identical conditions to numerator and denominator; omitting one condition can produce a plausible but wrong average."
  },
  "tasks": [
    {
      "id": "t1",
      "prompt": "Total Revenue_CAD for Region Cove, including both channels and both categories.",
      "output": "Answers!B2",
      "type": "number",
      "formulas": [
        "SUMIFS"
      ]
    },
    {
      "id": "t2",
      "prompt": "Count sales lines that are both Region Cove and Channel Wholesale. Count rows rather than sold units.",
      "output": "Answers!B3",
      "type": "number",
      "formulas": [
        "COUNTIFS"
      ]
    },
    {
      "id": "t3",
      "prompt": "Total Revenue_CAD for Region Cove, Channel Wholesale and Category Supplies together.",
      "output": "Answers!B4",
      "type": "number",
      "formulas": [
        "SUMIFS"
      ]
    },
    {
      "id": "t4",
      "prompt": "Calculate revenue per sales line for Region Cove and Channel Wholesale, rounded to two decimals. Divide that group’s total revenue by its matching line count. Use No sales if no matching rows exist.",
      "output": "Answers!B5",
      "type": "number",
      "formulas": [
        "SUMIFS",
        "COUNTIFS",
        "ROUND",
        "IFERROR"
      ]
    }
  ],
  "bonus": {
