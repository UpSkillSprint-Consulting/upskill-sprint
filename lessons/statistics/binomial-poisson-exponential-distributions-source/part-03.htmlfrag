<div class="control dynamic-fields" hidden="" id="wbExposureGroup"><label for="wbExposure">Exposure</label><input id="wbExposure" min="0" step="0.1" type="number" value="1"/></div>
<div class="control"><label for="wbX1" id="wbX1Label">Count x</label><input id="wbX1" min="0" step="1" type="number" value="2"/></div>
<div class="control dynamic-fields" hidden="" id="wbX2Group"><label for="wbX2" id="wbX2Label">Upper count x₂</label><input id="wbX2" min="0" step="1" type="number" value="4"/></div>
</div>
<div class="button-row"><button class="btn" id="wbCalculateBtn" type="button">Calculate probability</button><button class="btn secondary" id="wbSampleBtn" type="button">Load Poisson example</button><button class="btn secondary" id="wbResetBtn" type="button">Reset workbench</button></div>
<div aria-live="assertive" class="callout warn" hidden="" id="wbError"></div>
<div class="result-grid">
<div class="result-card"><span>Calculated probability</span><strong class="result-number" id="wbProbability">—</strong><p id="wbInterpretation">Choose inputs and calculate.</p></div>
