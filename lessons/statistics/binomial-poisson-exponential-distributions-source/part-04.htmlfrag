</main>
<!-- EDIT: Interactive lesson JavaScript -->

<script src="/lessons/statistics/binomial-poisson-exponential-distributions-base.js"></script><script src="/lessons/statistics/binomial-poisson-exponential-distributions-concepts.js"></script><script src="/lessons/statistics/binomial-poisson-exponential-distributions-workbench.js"></script><script src="/lessons/statistics/binomial-poisson-exponential-distributions-quality.js"></script><script>(() => {
  "use strict";
  const $ = id => document.getElementById(id);
  const feedback = [...document.querySelectorAll(".feedback")];
  feedback.forEach(item => { item.dataset.explanation = item.textContent.trim(); });
  $("quizForm").addEventListener("submit", () => queueMicrotask(() => {
    document.querySelectorAll(".quiz-question").forEach(question => {
      const item = question.querySelector(".feedback");
      const chosen = question.querySelector("input:checked");
      const prefix = chosen && chosen.value === question.dataset.answer ? "Correct. " : chosen ? "Not quite. " : "No answer selected. ";
      item.textContent = prefix + item.dataset.explanation;
    });
  }));
  const logFactorial = n => { let total = 0; for (let i = 2; i <= n; i++) total += Math.log(i); return total; };
  $("calculateBtn").addEventListener("click", event => {
    event.stopImmediatePropagation();
    const rate = Number($("calcRate").value), exposure = Number($("calcExposure").value), x = Number($("calcCount").value), box = $("calcMessage");
    if (!(rate > 0) || !(exposure >= 0) || !Number.isInteger(x) || x < 0 || x > 500) {
      box.textContent = "Enter a positive rate, a non-negative exposure, and a whole-number count from 0 to 500.";
      box.className = "callout warn";
      return;
    }
    const mu = rate * exposure;
    const pCount = mu === 0 ? (x === 0 ? 1 : 0) : Math.exp(-mu + x * Math.log(mu) - logFactorial(x));
    const pWait = Math.exp(-mu);
    box.innerHTML = `<strong>Expected count μ = ${mu.toFixed(4)}</strong><br>Poisson: P(X = ${x}) = ${pCount.toFixed(6)} (${(pCount * 100).toFixed(2)}%)<br>Exponential/zero-event bridge: P(T &gt; exposure) = P(X = 0) = ${pWait.toFixed(6)} (${(pWait * 100).toFixed(2)}%)`;
    box.className = "callout good";
  }, true);
  const clearIfNoEvents = () => queueMicrotask(() => {
    if (!$("labError").hidden) {
      ["countCanvas", "gapCanvas"].forEach(id => {
        const canvas = $(id), ctx = canvas.getContext("2d");
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      });
      $("mEvents").textContent = "0"; $("mRate").textContent = "0.00"; $("mCount").textContent = "0.00"; $("mGap").textContent = "No events";
    }
  });
  ["rateSlider", "lengthSlider", "windowSlider"].forEach(id => $(id).addEventListener("input", clearIfNoEvents));
  $("resimulateBtn").addEventListener("click", clearIfNoEvents);
})();</script></body>
</html>
